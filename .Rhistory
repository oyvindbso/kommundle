library(tidyverse)
library(data.table)
resultat<- read_csv2("O:/Nerding/2025-09-10_2025_st_partifordeling_landsoversikt_kommune.csv") %>% setDT()
resultat[Kommunenummer=="0301",.(Partinavn,`Oppslutning prosentvis`)]
resultat[Kommunenummer=="0301",.(Partinavn,round(`Oppslutning prosentvis`,1)]
resultat[Kommunenummer=="0301",.(Partinavn,round(`Oppslutning prosentvis`,1))]
for(knr in resultat$Kommunenummer[1:50]){
resultat[Kommunenummer=="0301",.(Partinavn,round(`Oppslutning prosentvis`,1))] %>%
slice_max(n=7,order_by = `Oppslutning prosentvis`) %>%
write_csv2(col_names = FALSE,file =
paste0("P:/kommundle_valg/public/data/countries/municip",knr,"/data.csv")
)
}
